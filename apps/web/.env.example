# Copy to .env.local for local work. Every value here is optional in development, except IP_HASH_SALT when DATABASE_URL is set.

# Where letters are saved. Leave empty in development to keep them in memory (lost on restart).
DATABASE_URL=

# Required whenever DATABASE_URL is set (in any environment): a long random string (16+ characters) used to hash client addresses for rate limiting.
IP_HASH_SALT=

# Optional: letters one address may make per hour (default 10).
RATE_LIMIT_PER_HOUR=

# Optional: memory or postgres. Set memory to let a production build run without a database (demos only).
PACKET_STORE=

# Optional: shown on the privacy and terms pages. Read when the page is requested.
CONTACT_EMAIL=

# Optional. Set to a domain to load Plausible's script and start sending events (spec §10).
# Unset means no analytics script ships and track() only logs to the console in development.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Required to run POST /api/cleanup (deletes expired letters and old rate-limit windows). Any long
# random string; Vercel Cron sends it back as `Authorization: Bearer <value>` when configured below.
CRON_SECRET=
